# Hermes Agent .env 示例 (脱敏)
# 拷贝到 ~/.hermes/.env，替换占位符。

# === LLM provider (custom OpenAI-compatible endpoint) ===
OPENAI_API_KEY=sk-dummy-not-required          # 端点不需要 key 时占位即可
# 如果想用 OpenRouter:
# OPENROUTER_API_KEY=sk-or-...
# 如果想用 Anthropic 官方:
# ANTHROPIC_API_KEY=sk-ant-...

# === Feishu ===
FEISHU_APP_ID=cli_XXXXXXXXXXXXXXXX
FEISHU_APP_SECRET=REPLACE_WITH_APP_SECRET
FEISHU_DOMAIN=feishu                           # 国际版 Lark 写 lark
FEISHU_CONNECTION_MODE=websocket

# 可选：限制谁可以 DM 机器人（推荐生产开启）
# FEISHU_ALLOWED_USERS=ou_xxx,ou_yyy
# FEISHU_HOME_CHANNEL=oc_xxxxxxxxxxxxxxxxxxxxxxxx   # cron 默认投递的群

# === Gateway 全局 ===
# 实验/单用户环境放开，正式部署务必删掉这一行并配 *_ALLOWED_USERS
GATEWAY_ALLOW_ALL_USERS=true

# === 其它平台示例（可选） ===
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=123456789
# DISCORD_BOT_TOKEN=
# SLACK_APP_TOKEN=xapp-...
# SLACK_BOT_TOKEN=xoxb-...
